# ============================================================
#  CHINOS CAFE S.A. - Configuracion de entorno
#  Copia este archivo como  .env  y coloca tus datos reales.
# ============================================================

# --- Clave secreta de Flask (cambia por cualquier texto) ---
SECRET_KEY=chinos-cafe-clave-secreta-2026

# --- Correo SMTP (Gmail) ---
# Para Gmail debes usar una "Contraseña de aplicacion" (App Password),
# NO tu contraseña normal.  Generala en:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# Correo de la EMPRESA (recibe confirmaciones de pedidos/pagos)
CORREO_EMPRESA=chinoscafe.empresa@gmail.com
# Correo del OPERARIO (cocina / despacho)
CORREO_OPERARIO=chinoscafe.operario@gmail.com

# --- Base de datos de replica ---
# Por defecto es un 2do archivo SQLite local (replica en la misma maquina).
# Para la Parte III puedes apuntar a la DB de la Maquina Virtual Linux.
DB_PRIMARY=database/chinos_primary.db
DB_REPLICA=database/chinos_replica.db
