# Copia este archivo como .env y completa los valores. El archivo .env NO se sube a GitHub.

# --- Correo (Gmail) ---------------------------------------------------------
SMTP_PASS=tu_contraseña_de_aplicacion
# Opcionales:
# SMTP_USER=tu_correo@gmail.com
# EMPRESA_CORREO=tu_correo@gmail.com
# FLASK_SECRET_KEY=una-clave-aleatoria-larga

# --- Base de datos ----------------------------------------------------------
# Sin DB_MOTOR (o con DB_MOTOR=sqlite) la app usa los archivos SQLite locales.
# Con MariaDB (servidor MAESTRO, ver README sección 4):
# DB_MOTOR=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3307
# DB_NAME=chinos_cafe
# DB_USER=chinos_app
# DB_PASSWORD=contraseña_del_usuario_de_la_app

# --- Réplica (servidor ESCLAVO en la máquina virtual) -----------------------
# Usuario con el que la VM copia los cambios del maestro:
# REPLICACION_USER=replicador
# REPLICACION_PASSWORD=contraseña_del_usuario_replicador
# Para ver el estado del esclavo en la página «Réplica»:
# DB_REPLICA_HOST=192.168.56.101
# DB_REPLICA_PORT=3306
# DB_REPLICA_USER=chinos_monitor
# DB_REPLICA_PASSWORD=contraseña_del_usuario_monitor
