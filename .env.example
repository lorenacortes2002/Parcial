# Copia este archivo como .env y pon tu contraseña de aplicación de Gmail.
# El archivo .env no se sube a GitHub.
SMTP_PASS=tu_contraseña_de_aplicacion
# Opcionales:
# SMTP_USER=tu_correo@gmail.com
# EMPRESA_CORREO=tu_correo@gmail.com
# FLASK_SECRET_KEY=una-clave-aleatoria-larga
# Réplica en la máquina virtual (ver README, sección 4):
# REPLICA_TOKEN=clave-larga-aleatoria-igual-en-la-PC-y-en-la-VM
# REPLICA_URL=http://IP-DE-LA-VM:5000   (solo en la PC, nunca en la VM)
# Para varias réplicas (tu VM y la de tu compañera), sepáralas con coma:
# REPLICA_URL=http://192.168.56.101:5000,http://100.x.x.x:5000
